# Salin ke .env lalu isi nilainya. File .env sudah di-ignore oleh git.

# Token bot dari @BotFather (wajib)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Daftar chat id yang diizinkan, pisahkan dengan koma (wajib).
# Cara tahu chat id Anda: kirim pesan ke bot, lihat log "tolak chat..." atau
# gunakan bot @userinfobot.
ALLOWED_CHAT_IDS=123456789

# Alamat listen HTTP service ini.
LISTEN_ADDR=:8080

# Path endpoint webhook (boleh diganti agar sulit ditebak).
WEBHOOK_PATH=/telegram/webhook

# Base URL publik tempat service ini bisa diakses Telegram (untuk -set-webhook).
# Mis. hasil tunnel cloudflared/ngrok atau domain VPS Anda.
# Bila AUTO_TUNNEL=true, nilai ini DIABAIKAN (URL diambil dari cloudflared).
WEBHOOK_URL=https://contoh-anda.trycloudflare.com

# ---- Auto-tunnel (opsional) ----
# Bila true: service menjalankan cloudflared sendiri, mengambil URL-nya, lalu
# mendaftarkan webhook otomatis tiap kali dijalankan (cukup `./rprompt.exe`).
# Saat service berhenti, webhook dihapus & cloudflared dimatikan.
# Catatan: quick-tunnel butuh ~1-2 menit untuk propagasi DNS sebelum webhook bisa
# didaftarkan; ini normal. Untuk URL tetap & tanpa tunggu, pakai named tunnel.
AUTO_TUNNEL=false
CLOUDFLARED_BIN=cloudflared

# Secret token yang divalidasi pada setiap update Telegram (sangat disarankan).
# Buat string acak panjang, mis. dengan: openssl rand -hex 32
WEBHOOK_SECRET=ganti-dengan-string-acak-panjang

# Path binary claude. Di Windows biasanya "claude" cukup bila ada di PATH.
CLAUDE_BIN=claude

# Direktori proyek tempat Claude Code dijalankan.
WORK_DIR=.

# Argumen tambahan untuk claude. Di mode headless, tool yang butuh izin akan
# GAGAL karena tidak ada yang menekan "izinkan". Pilihan, dari paling aman:
#   (kosong)                              -> hanya tool tanpa-izin yang jalan
#   --permission-mode acceptEdits         -> auto-setujui edit file saja
#   --allowedTools "Read Grep Glob Bash"  -> hanya izinkan tool tertentu
#   --dangerously-skip-permissions        -> jalankan SEMUA tool tanpa bertanya
# Gunakan opsi terakhir hanya bila Anda paham risikonya.
# CATATAN: bila INTERACTIVE_PERMISSIONS=true, JANGAN isi --dangerously-skip-permissions
# (akan membatalkan alur izin via tombol).
CLAUDE_EXTRA_ARGS=

# ---- Izin interaktif via tombol Telegram (opsional) ----
# Bila true: tiap tool yang butuh izin akan mengirim tombol [Izinkan]/[Tolak]
# ke Telegram, dan Claude menunggu keputusan Anda. Ini alternatif lebih aman
# daripada --dangerously-skip-permissions.
INTERACTIVE_PERMISSIONS=false

# Alamat listen lokal server MCP (jembatan izin). Cukup localhost; tidak perlu
# diekspos ke internet.
MCP_ADDR=127.0.0.1:8765
MCP_PATH=/mcp

# Batas waktu menunggu Anda menekan tombol sebelum otomatis DITOLAK (detik).
APPROVAL_TIMEOUT_SECONDS=120

# Format hasil keputusan izin yang dikembalikan ke Claude. Kontraknya kurang
# terdokumentasi; bila "behavior" tidak berfungsi pada versi Claude Code Anda,
# coba "hook". Pilihan: behavior | hook
PERMISSION_RESULT_FORMAT=behavior

# Batas waktu eksekusi satu prompt (detik).
CLAUDE_TIMEOUT_SECONDS=600

# File penyimpanan session id per chat.
SESSION_FILE=sessions.json
