# Salin ke .env lalu isi. File .env sudah di-ignore git.

# ===== WAJIB =====
# Token bot dari @BotFather
TELEGRAM_BOT_TOKEN=
# Chat id yang boleh memakai bot (pisahkan koma). Cek id Anda: @userinfobot
ALLOWED_CHAT_IDS=

# ===== TELEGRAM =====
# Cara terima pesan:
#   polling  -> bot menarik update sendiri; tanpa tunnel/URL publik (portabel, di balik NAT)
#   webhook  -> Telegram kirim ke URL publik Anda (butuh tunnel/VPS; lihat blok EKSPOS)
TELEGRAM_MODE=polling

# ===== CLAUDE =====
# Nama/path binary claude (cukup "claude" bila ada di PATH)
CLAUDE_BIN=claude
# Folder kerja default tempat claude dijalankan
WORK_DIR=.
# Whitelist folder untuk perintah /project <nama>. Format: nama=path;nama2=path2
# Contoh: PROJECTS=web=C:/proyek/web;api=C:/proyek/api
PROJECTS=
# Batas waktu satu prompt (detik)
CLAUDE_TIMEOUT_SECONDS=600
# File penyimpanan session id per chat
SESSION_FILE=sessions.json
# Argumen ekstra claude. Untuk izin tool TANPA tombol (lihat blok IZIN), mis:
#   --permission-mode acceptEdits   (auto-setujui edit)
#   --dangerously-skip-permissions  (jalankan semua tool tanpa tanya; pahami risikonya)
CLAUDE_EXTRA_ARGS=

# ===== IZIN TOOL VIA TOMBOL (opsional) =====
# true: tiap tool yang butuh izin kirim tombol [Izinkan]/[Tolak] ke Telegram.
# (Jangan dipakai bareng --dangerously-skip-permissions di CLAUDE_EXTRA_ARGS.)
INTERACTIVE_PERMISSIONS=false
MCP_ADDR=127.0.0.1:8765
MCP_PATH=/mcp
# Auto-TOLAK bila tombol tak ditekan dalam sekian detik
APPROVAL_TIMEOUT_SECONDS=120
# Format hasil izin: behavior (default) | hook (coba bila tombol tak berpengaruh)
PERMISSION_RESULT_FORMAT=behavior

# ===== EKSPOS KE INTERNET (untuk HTTP API / mode webhook) =====
# Alamat listen HTTP (webhook + API; di mode polling tetap untuk API lokal/healthz)
LISTEN_ADDR=:8080
CLOUDFLARED_BIN=cloudflared
# Named tunnel (URL TETAP): rprompt menjalankan `cloudflared tunnel run <nama>`
# sendiri. Pasangkan dengan TELEGRAM_MODE=webhook + SET_WEBHOOK_ON_START=true agar
# bot DAN API lewat tunnel yang sama. TIDAK boleh bareng AUTO_TUNNEL.
CLOUDFLARED_TUNNEL=
# Quick tunnel (URL acak) + daftar webhook otomatis. (Bawaan: true)
AUTO_TUNNEL=true
# -- khusus TELEGRAM_MODE=webhook --
WEBHOOK_PATH=/telegram/webhook
WEBHOOK_URL=https://contoh-anda.com          # URL publik HTTPS Anda
WEBHOOK_SECRET=ganti-string-acak-panjang     # mis: openssl rand -hex 32
# true: daftarkan WEBHOOK_URL saat start (URL tetap), tanpa perlu -set-webhook manual
SET_WEBHOOK_ON_START=false

# ===== HTTP API OpenAI-compatible (opsional) =====
# Endpoint POST /v1/chat/completions & GET /v1/models (kompatibel OpenAI SDK/dll).
# base_url -> http://host:8080/v1 ; api_key -> API_TOKEN (header Authorization: Bearer)
# API menyala secara default (Bawaan: true).
API_ENABLED=true
# Bila API_TOKEN kosong, rprompt akan otomatis men-generate token acak saat dijalankan.
API_TOKEN=                                   # rahasia; mis: openssl rand -hex 24
# Maks eksekusi API paralel. 0 = tak terbatas; bila penuh -> 429
API_MAX_CONCURRENT=0

# ===== ENGINE GEMINI di API (opsional) =====
# Request dengan model diawali "gemini" dialihkan ke Gemini CLI (selain itu Claude).
# Butuh: npm i -g @google/gemini-cli (Node 20+) lalu `gemini` login.
GEMINI_ENABLED=false
# Nama pendek "gemini" cukup bila di PATH. Windows: folder Node HARUS di PATH.
GEMINI_BIN=gemini
# Kosongkan bila sudah `gemini` login (OAuth). Atau isi API key dari Google AI Studio.
GEMINI_API_KEY=
# true: PAKSA login CLI (rprompt buang GEMINI_API_KEY/GOOGLE_API_KEY dari subprocess)
GEMINI_USE_OAUTH=false
# Argumen ekstra gemini (auto-approve & pilih model) agar tak menggantung headless
GEMINI_EXTRA_ARGS=--approval-mode yolo

# ===== ENGINE KIRO di API (opsional) =====
# Request dengan model "kiro" dialihkan ke Kiro CLI.
# Butuh: kiro-cli terinstal dan ada di PATH.
KIRO_ENABLED=false
KIRO_BIN=kiro-cli
KIRO_EXTRA_ARGS=

# ===== ENGINE BOB SHELL di API (opsional) =====
# Request dengan model "bob" atau "bob-shell" dialihkan ke Bob Shell CLI.
# Butuh: npm i -g @ibm/bob
BOB_ENABLED=false
BOB_BIN=bob
# Argumen ekstra bob. Disarankan kosong, karena rprompt otomatis menambahkan -y (yolo mode)
BOB_EXTRA_ARGS=
